library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity Restador4 is
    port (
        a3, a2, a1, a0 : in  std_logic;
        b3, b2, b1, b0 : in  std_logic;
        diferencia     : out std_logic_vector(3 downto 0);
        prestamo       : out std_logic
    );
end entity Restador4;

architecture estructural of Restador4 is

    signal borrow0, borrow1, borrow2, borrow3 : std_logic;

    component Fullsubstractor is
        port (
            a    : in  std_logic;
            b    : in  std_logic;
            bin  : in  std_logic;
            d    : out std_logic;
            bout : out std_logic
        );
    end component;

begin

    -- Bit menos significativo: préstamo de entrada = '0'
    borrow0 <= '0';

    FS0: Fullsubstractor
        port map (a => a0, b => b0, bin => borrow0, d => diferencia(0), bout => borrow1);

    FS1: Fullsubstractor
        port map (a => a1, b => b1, bin => borrow1, d => diferencia(1), bout => borrow2);

    FS2: Fullsubstractor
        port map (a => a2, b => b2, bin => borrow2, d => diferencia(2), bout => borrow3);

    FS3: Fullsubstractor
        port map (a => a3, b => b3, bin => borrow3, d => diferencia(3), bout => prestamo);

end architecture estructural;
